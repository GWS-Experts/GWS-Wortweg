# Supabase project for GWS-Wortweg (accounts and progress sync).
# The publishable key is meant for browsers and safe to share; data is protected by Row Level Security.
# Copy this file to .env.local. Leave the values empty to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=https://wsqsehgqbctdzdiplglw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ByKnfJOm4tq2bNnEVDUgfg_shyX40-C

# AI tutor "Lena" (server only, never exposed to the browser).
# Create a key at https://platform.claude.com and add it in Vercel → Settings → Environment Variables.
# Without it the tutor page shows "not set up yet"; everything else works.
ANTHROPIC_API_KEY=
# Optional: a cheaper model for the tutor, e.g. claude-haiku-5-5 (default: claude-opus-5-5).
TUTOR_MODEL=
