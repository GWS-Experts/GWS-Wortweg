{
  "id": "a1-01",
  "level": "A1",
  "order": 1,
  "title_de": "Hallo, ich bin Emma!",
  "title_en": "Hello, I'm Emma!",
  "goal_en": "Greet people, say your name and where you come from.",
  "scene": {
    "setting_en": "Emma arrives at her new flat in Marzling. Her landlady, Frau Huber, opens the door.",
    "lines": [
      { "speaker": "frau_huber", "de": "Grüß Gott! Sind Sie Frau Clarke?", "en": "Hello! Are you Ms Clarke?" },
      { "speaker": "emma", "de": "Ja, hallo! Ich bin Emma Clarke.", "en": "Yes, hello! I'm Emma Clarke." },
      { "speaker": "frau_huber", "de": "Herzlich willkommen in Marzling! Ich heiße Huber, Maria Huber.", "en": "A warm welcome to Marzling! My name is Huber, Maria Huber." },
      { "speaker": "emma", "de": "Freut mich, Frau Huber.", "en": "Nice to meet you, Mrs Huber." },
      { "speaker": "frau_huber", "de": "Woher kommen Sie?", "en": "Where are you from?" },
      { "speaker": "emma", "de": "Ich komme aus England, aus Leeds.", "en": "I'm from England, from Leeds." },
      { "speaker": "frau_huber", "de": "Schön! Kommen Sie rein!", "en": "Lovely! Come in!" }
    ]
  },
  "vocabulary": [
