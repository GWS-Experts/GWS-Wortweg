    { "id": "gruess_gott", "de": "Grüß Gott", "type": "phrase", "en": "hello (common in Bavaria)", "example_de": "Grüß Gott, Frau Huber!", "example_en": "Hello, Mrs Huber!", "note_en": "Typical greeting in Bavaria and Austria. 'Guten Tag' is understood everywhere." },
    { "id": "guten_tag", "de": "Guten Tag", "type": "phrase", "en": "good day / hello", "example_de": "Guten Tag! Ich bin Emma Clarke.", "example_en": "Good day! I'm Emma Clarke." },
    { "id": "ich", "de": "ich", "type": "pronoun", "en": "I", "example_de": "Ich bin Emma.", "example_en": "I am Emma." },
