  "dialogue": {
    "setting_en": "Lukas from the bakery walks past and says hello. Answer him.",
    "turns": [
      { "speaker": "lukas", "de": "Hallo! Ich bin Lukas. Und wie heißt du?", "en": "Hi! I'm Lukas. And what's your name?" },
      {
        "learner": true,
        "options": [
          { "de": "Ich heiße Emma.", "correct": true, "feedback_en": "Perfect! Lukas uses 'du', the informal 'you', so a simple answer works." },
          { "de": "Ich komme aus Emma.", "correct": false, "feedback_en": "'aus' means 'from' and is used for places, not names." },
          { "de": "Freut mich, Herr Lukas.", "correct": false, "feedback_en": "Close! But 'Herr' goes with surnames, and Lukas asked for your name." }
        ]
      },
      { "speaker": "lukas", "de": "Woher kommst du?", "en": "Where are you from?" },
      {
        "learner": true,
        "options": [
          { "de": "Ich komme aus England.", "correct": true, "feedback_en": "Great! 'aus' + country." },
