  ],
  "grammar": {
    "title_en": "Saying who you are: 'sein' and 'heißen'",
    "explanation_en": "German has two common ways to say your name: 'Ich bin Emma' (I am Emma) and 'Ich heiße Emma' (I am called Emma). With strangers and older people, Germans use the polite 'Sie' (you). The verb then ends in -en: 'Woher kommen Sie?', 'Sind Sie Frau Clarke?'.",
    "table": {
      "headers": ["", "sein", "heißen", "kommen"],
      "rows": [
        ["ich", "bin", "heiße", "komme"],
        ["Sie (polite you)", "sind", "heißen", "kommen"]
      ]
    },
    "examples": [
      { "de": "Ich bin Emma.", "en": "I am Emma." },
      { "de": "Wie heißen Sie?", "en": "What is your name? (polite)" },
      { "de": "Woher kommen Sie?", "en": "Where are you from? (polite)" }
    ]
  },
