      "sentence_de": "Ich möchte ___ Kaffee.",
      "options": ["einen", "eine", "ein"],
      "answer": "einen",
      "translation_en": "I'd like a coffee."
    },
    {
      "id": "a1-02-e4",
      "type": "word_order",
      "prompt_en": "Put the words in the right order.",
      "words": ["macht", "Das", "Euro", "fünf", "."],
      "answer": "Das macht fünf Euro.",
      "translation_en": "That's five euros."
    },
    {
