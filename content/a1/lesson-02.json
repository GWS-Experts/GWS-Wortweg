          { "de": "Ja, einen Breze.", "correct": false, "feedback_en": "'Breze' is feminine (die Breze), so it's 'eine Breze'." },
          { "de": "Grüß Gott.", "correct": false, "feedback_en": "That's a greeting. Lukas asked if you want anything else." }
        ]
      },
      { "speaker": "lukas", "de": "Das macht zwei Euro.", "en": "That's two euros." }
    ]
  }
