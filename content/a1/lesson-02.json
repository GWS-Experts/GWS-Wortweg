      "type": "match_pairs",
      "prompt_en": "Match the German and English words.",
      "pairs": [
        { "de": "die Breze", "en": "pretzel" },
        { "de": "die Semmel", "en": "bread roll" },
        { "de": "der Kaffee", "en": "coffee" },
        { "de": "danke", "en": "thank you" }
      ]
    }
  ],
  "dialogue": {
    "setting_en": "It's Saturday. You are at the bakery again. Order breakfast.",
    "turns": [
      { "speaker": "lukas", "de": "Servus, Emma! Was möchtest du heute?", "en": "Hi, Emma! What would you like today?" },
      {
        "learner": true,
        "options": [
          { "de": "Ich möchte drei Semmeln, bitte.", "correct": true, "feedback_en": "Well done! Polite and clear." },
          { "de": "Ich möchtest drei Semmeln.", "correct": false, "feedback_en": "With 'ich' it's 'möchte' without -st." },
          { "de": "Danke, drei Semmeln.", "correct": false, "feedback_en": "Use 'bitte' when you ask for something and 'danke' when you get it." }
        ]
      },
