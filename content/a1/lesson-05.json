    { "id": "kaese", "de": "Käse", "article": "der", "plural": null, "type": "noun", "en": "cheese", "example_de": "Der Käse ist aus Bayern.", "example_en": "The cheese is from Bavaria." },
    { "id": "tomate", "de": "Tomate", "article": "die", "plural": "die Tomaten", "type": "noun", "en": "tomato", "example_de": "Die Tomaten sind billig.", "example_en": "The tomatoes are cheap." },
    { "id": "gemuese", "de": "Gemüse", "article": "das", "plural": null, "type": "noun", "en": "vegetables", "example_de": "Das Gemüse ist da hinten.", "example_en": "The vegetables are back there." },
