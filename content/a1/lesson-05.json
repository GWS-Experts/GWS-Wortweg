    { "id": "zwanzig_bis_fuenfzig", "de": "zwanzig, dreißig, vierzig, fünfzig", "type": "number", "en": "twenty, thirty, forty, fifty", "example_de": "Das kostet dreißig Cent.", "example_en": "That costs thirty cents." },
