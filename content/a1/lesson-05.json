  "dialogue": {
    "setting_en": "You are at the checkout. Talk to the cashier.",
    "turns": [
      { "speaker": "kassiererin", "de": "Guten Tag! Brauchen Sie eine Tüte?", "en": "Hello! Do you need a bag?" },
      {
        "learner": true,
        "options": [
