  "grammar": {
    "title_en": "Plural forms",
    "explanation_en": "German plurals come in several patterns, so learn each noun with its plural. Common endings are -e, -er, -n/-en and -s; some nouns also get an umlaut (a → ä). The article in the plural is always 'die'. Tip: most feminine nouns ending in -e just add -n (die Tomate → die Tomaten).",
    "table": {
      "headers": ["Pattern", "Singular", "Plural"],
      "rows": [
        ["-n / -en", "die Tomate", "die Tomaten"],
        ["-er", "das Ei", "die Eier"],
        ["umlaut", "der Apfel", "die Äpfel"],
        ["-e", "der Tisch", "die Tische"],
        ["-s", "der Kaffee", "die Kaffees"]
      ]
    },
    "examples": [
      { "de": "Ich nehme drei Tomaten.", "en": "I'll take three tomatoes." },
      { "de": "Wo sind die Eier?", "en": "Where are the eggs?" }
    ]
  },
