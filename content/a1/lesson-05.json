  "title_de": "Im Supermarkt",
  "title_en": "At the supermarket",
  "goal_en": "Buy food, ask for prices and use plural forms.",
  "scene": {
    "setting_en": "Emma does her first big shop at the supermarket.",
    "lines": [
      { "speaker": "emma", "de": "Entschuldigung, wo sind die Äpfel?", "en": "Excuse me, where are the apples?" },
      { "speaker": "kassiererin", "de": "Die Äpfel sind da hinten, beim Gemüse.", "en": "The apples are back there, by the vegetables." },
      { "speaker": "emma", "de": "Danke. Und was kostet die Milch?", "en": "Thanks. And how much is the milk?" },
      { "speaker": "kassiererin", "de": "Ein Liter kostet einen Euro zwanzig.", "en": "One litre costs one euro twenty." },
      { "speaker": "emma", "de": "Gut, dann nehme ich zwei Liter Milch und sechs Eier.", "en": "Good, then I'll take two litres of milk and six eggs." },
      { "speaker": "kassiererin", "de": "Das macht zusammen sieben Euro fünfzig. Brauchen Sie eine Tüte?", "en": "That's seven euros fifty altogether. Do you need a bag?" },
      { "speaker": "emma", "de": "Nein, danke. Ich habe eine Tasche.", "en": "No, thanks. I have a bag." }
    ]
  },
  "vocabulary": [
